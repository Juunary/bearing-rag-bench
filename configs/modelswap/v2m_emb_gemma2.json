{
  "exp_id": "v2m_emb_gemma2",
  "stage": "v2m",
  "description": "English-pivot RRF, reranker reads English chunks and English query (top 30); embedding EmbeddingGemma 2 (mean pooling, task prefixes, bf16) [eval: 90 v2 questions]",
  "eval_path": "eval/queries_v2.jsonl",
  "retrieval": {
    "top_k": 10,
    "method": "hybrid_rerank",
    "bm25_tokenizer": "whitespace",
    "bm25_english_pivot": true,
    "embedding_model": "google/embeddinggemma-2",
    "rrf_k": 60,
    "fusion_candidates": 50,
    "rerank_model": "BAAI/bge-reranker-v2-m3",
    "rerank_top_n": 30,
    "rerank_text": "english",
    "embedding_pooling": "mean",
    "embedding_query_prefix": "task: search result | query: ",
    "embedding_doc_prefix": "title: none | text: ",
    "embedding_dtype": "bf16"
  },
  "chunking": {
    "corpus": "wiki"
  }
}
