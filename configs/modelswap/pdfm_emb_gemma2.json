{
  "exp_id": "pdfm_emb_gemma2",
  "stage": "pdfm",
  "description": "RRF over English BM25 + English dense, reranker reads English (top 30); embedding EmbeddingGemma 2 (mean pooling, task prefixes, bf16) [eval: 48 PDF questions, table headers repeated]",
  "eval_path": "eval/queries_pdf.jsonl",
  "retrieval": {
    "top_k": 10,
    "method": "hybrid_rerank",
    "bm25_tokenizer": "whitespace",
    "bm25_english_pivot": true,
    "embedding_model": "google/embeddinggemma-2",
    "rrf_k": 60,
    "fusion_candidates": 50,
    "rerank_model": "BAAI/bge-reranker-v2-m3",
    "rerank_top_n": 30,
    "rerank_text": "english",
    "dense_english_pivot": true,
    "embedding_pooling": "mean",
    "embedding_query_prefix": "task: search result | query: ",
    "embedding_doc_prefix": "title: none | text: ",
    "embedding_dtype": "bf16"
  },
  "chunking": {
    "corpus": "wiki_pdf",
    "table_header": true
  }
}
